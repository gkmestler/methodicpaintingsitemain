# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=contact@methodicpainting.com

# Sender address. onboarding@resend.dev works out of the box for testing but can
# only deliver to the email on your Resend account. After you verify
# methodicpainting.com in Resend (Domains > Add Domain, then add the DNS records),
# change this to something like "Methodic Painting <contact@methodicpainting.com>".
CONTACT_FROM_EMAIL=onboarding@resend.dev
